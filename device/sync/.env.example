# Archivos compose activos, separados por ":"

COMPOSE_FILE=docker-compose.yml:acq-dht/compose.yml:acq-pir/compose.yml:processing/compose.yml:sync/compose.yml

SIMULATE=true            # true = datos simulados; false = sensores reales
DHT_GPIO=4               # GPIO (BCM) del DATA del DHT11 (pin físico 7)
PIR_GPIO=17              # GPIO (BCM) del OUT del PIR (pin físico 11)
API_URL=http://(IPPC):3000/api/device/sync
DEVICE_TOKEN=orgId.deviceId.secreto
SYNC_INTERVAL_SEC=60
